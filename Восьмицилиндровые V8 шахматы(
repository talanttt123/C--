void doska(int pole[8][8])
 {
    printf("    a   b   c   d   e   f   g   h\n");
    for (int i = 0; i < 8; i++) {
    SetConsoleTextAttribute(hConsole, 7);
    printf("  +---+---+---+---+---+---+---+---+\n");
    SetConsoleTextAttribute(hConsole, 7);
    printf("%d |", 8 - i);
        for (int j = 0; j < 8; j++) {
           
            int bg = ((i + j) % 2 == 0) ? 7 : 6;

           
            int text;
            if (pole[i][j] < 0) {
                text = 15;  
            } else if (pole[i][j] > 0) {
                text = 0;                                               //доска
            } else {
                text = 7;
            }

            setColor(text, bg);
            printf(" ");
            orobrazheniefigur(pole[i][j]);   
            printf(" ");

            SetConsoleTextAttribute(hConsole, 7);
            printf("|");
        }

        SetConsoleTextAttribute(hConsole, 7);
        printf(" %d\n", 8 - i);
    }

    SetConsoleTextAttribute(hConsole, 7);
    printf("  +---+---+---+---+---+---+---+---+\n");
    printf("    a   b   c   d   e   f   g   h\n");
}
